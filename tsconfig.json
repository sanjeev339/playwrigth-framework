{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node", "@playwright/test"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "playwright.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "reports",
    "dynamic-recon",
    "recon",
    "recon-summary",
    "scenario-actions",
    "scenarios",
    "specs",
    "tests/generated",
    "tests/healed"
  ]
}
