# --- LLM Provider Selection ---
# Set to 'openai' or 'gemini'
LLM_PROVIDER=openai

# Note: List-type configurations (e.g. custom test ID attributes, concurrency limits)
# are configured in config.yaml at the root of the project. See config.yaml.example.


# --- OpenAI Configuration ---
# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# --- Gemini Configuration ---
# Required if LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# --- Application Web Credentials ---
# Required for target app automation
WEBSITE_URL=https://your-app-url.example.com
LOGIN_EMAIL=your_email@example.com
LOGIN_PASSWORD=your_password_here

# --- Execution Settings ---
ACTION_DECISION_MODE=deterministic_first
HEADLESS=false
SLOW_MO=100

# --- LLM Logging Configuration ---
LOG_LLM_IO=true
LLM_IO_MAX_CHARS=20000

# --- Locator Policies ---
ALLOW_XPATH_LOCATORS=false
ALLOW_POSITIONAL_LOCATORS=false

# --- Input Paths Configuration ---
INPUT_FLOW_PATH=input/UC_trail_pw.xlsx
INPUT_DATA_PATH=input/test_data_enriched.json
EXTRACTED_REQUIREMENTS_PATH=input/extracted_requirements.md 

# --- Custom Paths (Optional - defaults will be used if omitted) ---
# SCENARIO_OUTPUT_DIR=scenarios
# RECON_SUMMARY_OUTPUT_DIR=recon-summary
# DYNAMIC_RECON_OUTPUT_DIR=dynamic-recon
# GENERATED_TEST_OUTPUT_DIR=tests/generated
# GENERATED_TEST_QUARANTINE_DIR=generated-quarantine
# HEALED_TEST_OUTPUT_DIR=tests/healed
# REPORT_OUTPUT_DIR=reports
# FRONTEND_REVIEW_OUTPUT_DIR=reports/frontend-reviews

